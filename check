#!/bin/sh
# Starter gate from repo birth — EXTEND ME as the repo grows content.
# Hook = CI = this file (parity rule). Fetch BEFORE check, ALWAYS
# (QPMSEC-436 review round 2, finding 2): a fresh clone carries no
# .cache/ (gitignored), so instructions.py itself does not exist on
# disk until scripts/qp-skills-fetch.sh vendors it — this order is the
# only one that can ever work, and a fetch failure surfaces as that
# script's own clear git error, never a Python stack trace for a file
# that is not there yet. Skills and agents share one pinned source.
set -e
sh scripts/qp-skills-fetch.sh
python3 .cache/qpai-skills/skills/repo-instructions/scripts/instructions.py check . --require-sources
find . -name '*.sh' -not -path './.git/*' -not -path './.cache/*' -exec sh -n {} +

echo "==> actionlint (every workflow file this repo ships — QPMSEC-570 round-2 review finding 2)"
sh scripts/install-actionlint.sh
export PATH="${ACTIONLINT_BIN_DIR:-$HOME/.local/bin}:$PATH"
actionlint .github/workflows/*.yml

echo "==> verify-git-auth-insteadof.sh (network-free proof the git-auth rewrite covers all three private-dep URL forms)"
sh scripts/verify-git-auth-insteadof.sh

echo "check: green"
