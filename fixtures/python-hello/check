#!/bin/sh
# Self-test fixture for python-gate.yml (QPMSEC-570): a real, tiny uv
# project exercised by python-gate.yml's format-lint/test/image jobs via
# self-test.yml's `working-directory: fixtures/python-hello`. ruff and
# pytest run via `uvx`/`uv run` — no project dependency, this fixture
# stays dependency-free on purpose.
set -e

run_fmt() {
  echo "==> ruff format --check"
  uvx ruff format --check .
}

run_lint() {
  echo "==> ruff check"
  uvx ruff check .
}

run_test() {
  echo "==> pytest"
  uvx --with pytest pytest src
}

run_image() {
  echo "==> docker build"
  if command -v docker >/dev/null 2>&1; then
    docker build -t python-hello-selftest .
  else
    echo "    NOTICE: docker not found on PATH — skipping the image build."
  fi
}

case "${1:-}" in
  fmt) run_fmt ;;
  lint) run_lint ;;
  test) run_test ;;
  image) run_image ;;
  "") run_fmt; run_lint; run_test; run_image ;;
  *) echo "unknown stage: $1 (expected fmt|lint|test|image)" >&2; exit 1 ;;
esac

echo "check: green"
